#!/bin/bash

# Detect Amazon Linux version
OS_VERSION=$(cat /etc/os-release | grep -oP '(?<=VERSION_ID=")[^"]+')

echo "Detected Amazon Linux version: $OS_VERSION"

# Install Nginx depending on version
if [[ "$OS_VERSION" == "2" ]]; then
    # Amazon Linux 2
    sudo amazon-linux-extras enable nginx1 -y
    sudo yum install -y nginx
elif [[ "$OS_VERSION" == "2023" ]]; then
    # Amazon Linux 2023
    sudo dnf install -y nginx
else
    echo "Unsupported Amazon Linux version: $OS_VERSION"
    exit 1
fi

# Start and enable Nginx
sudo systemctl start nginx
sudo systemctl enable nginx

# Get hostname of the instance
HOSTNAME=$(hostname)

# Create unique index.html content with background color
sudo bash -c "cat > /usr/share/nginx/html/index.html <<EOF
<!DOCTYPE html>
<html>
<head>
    <title>Nginx Instance</title>
    <style>
        body { 
            background-color: #$(echo $((RANDOM%999999)) | awk '{printf "%06d", $1}'); 
            color: white; 
            text-align: center; 
            font-family: Arial, sans-serif; 
        }
    </style>
</head>
<body>
    <h1>Welcome from $HOSTNAME</h1>
    <p>This page is served by instance: $HOSTNAME</p>
</body>
</html>
EOF"

# Restart Nginx to apply changes
sudo systemctl restart nginx

# Show status
sudo systemctl status nginx --no-pager
